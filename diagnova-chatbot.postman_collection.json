    },
    {
      "name": "Verification",
      "item": [
        {
          "name": "Confirm Session Deleted from Redis",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrlFastapi}}/internal/chat/message",
              "host": ["{{baseUrlFastapi}}"],
              "path": ["internal", "chat", "message"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"session_id\": \"{{sessionId}}\",\n  \"message\": \"Hello, what can you help me with?\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function uuidv4() {",
                  "  return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {",
                  "    const r = (Math.random() * 16) | 0;",
                  "    const v = c === 'x' ? r : (r & 0x3) | 0x8;",
                  "    return v.toString(16);",
                  "  });",
                  "}",
                  "const current = pm.collectionVariables.get('sessionId') || '';",
                  "if (!current) {",
                  "  const fresh = uuidv4();",
                  "  pm.collectionVariables.set('sessionId', fresh);",
                  "  console.log('[DIAGNOVA] WARNING: sessionId was already cleared — generated a fresh one: ' + fresh);",
                  "}",
                  "pm.request.headers.upsert({ key: 'x-internal-key', value: pm.collectionVariables.get('internalSecret') || '' });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const log = (m) => console.log('[DIAGNOVA] ' + m);",
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const raw = pm.response.text() || '';",
                  "function parseSse(text) {",
                  "  const events = [];",
                  "  const lines = text.split('\\n');",
                  "  for (const ln of lines) {",
                  "    if (!ln) continue;",
                  "    if (ln.indexOf('data: ') !== 0) continue;",
                  "    const payload = ln.slice(6);",
                  "    try { events.push(JSON.parse(payload)); } catch (e) { /* skip */ }",
                  "  }",
                  "  return events;",
                  "}",
                  "const events = parseSse(raw);",
                  "const errors = events.filter(e => e && e.type === 'error');",
                  "const chunks = events.filter(e => e && e.type === 'chunk');",
                  "const assembled = chunks.map(c => c.text || '').join('');",
                  "pm.test('No error event', function () { pm.expect(errors.length).to.eql(0); });",
                  "pm.test('Has chunks (valid intro response)', function () { pm.expect(chunks.length).to.be.greaterThan(0); });",
                  "log('Fresh session response: ' + assembled);",
                  "log('Fresh session confirmed — no stale history');"
                ]
              }
            }
          ]
        },
