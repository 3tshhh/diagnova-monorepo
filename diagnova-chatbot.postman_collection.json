{
  "info": {
    "name": "DIAGNOVA Chatbot",
    "_postman_id": "8e3a7b6c-1f2d-4e5a-9c0b-d4f3a1b2c3d4",
    "description": "End-to-end Postman collection for the DIAGNOVA chatbot pipeline. Covers NestJS-fronted streaming chat, direct FastAPI internal endpoints, auth, validation, throttling, and Redis session lifecycle. All requests are dynamic via collection variables. Set patientEmail, patientPassword, and internalSecret once, then run Login → the rest of the folders.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrlNest",     "value": "http://localhost:3000", "type": "string" },
    { "key": "baseUrlFastapi",  "value": "http://localhost:8000", "type": "string" },
    { "key": "internalSecret",  "value": "",                      "type": "string" },
    { "key": "jwtToken",        "value": "",                      "type": "string" },
    { "key": "sessionId",       "value": "",                      "type": "string" },
    { "key": "patientEmail",    "value": "",                      "type": "string" },
    { "key": "patientPassword", "value": "",                      "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrlNest}}/auth/login",
              "host": ["{{baseUrlNest}}"],
              "path": ["auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{patientEmail}}\",\n  \"password\": \"{{patientPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const log = (m) => console.log('[DIAGNOVA] ' + m);",
                  "pm.test('Login status 200/201', function () {",
                  "  pm.expect([200, 201]).to.include(pm.response.code);",
                  "});",
                  "let body = {};",
                  "try { body = pm.response.json(); } catch (e) { body = {}; }",
                  "function pickToken(obj) {",
                  "  if (!obj || typeof obj !== 'object') return '';",
                  "  const candidates = [",
                  "    obj.token,",
                  "    obj.access_token,",
                  "    obj.accessToken,",
                  "    obj.jwt,",
                  "    obj.data && obj.data.token,",
                  "    obj.data && obj.data.access_token,",
                  "    obj.data && obj.data.accessToken,",
                  "    obj.data && obj.data.jwt,",
                  "    obj.result && obj.result.token,",
                  "    obj.result && obj.result.access_token,",
                  "    obj.payload && obj.payload.token,",
                  "    obj.payload && obj.payload.access_token",
                  "  ];",
                  "  for (const c of candidates) {",
                  "    if (typeof c === 'string' && c.length > 0) return c;",
                  "  }",
                  "  return '';",
                  "}",
                  "const token = pickToken(body);",
                  "pm.test('JWT extracted', function () {",
                  "  pm.expect(token, 'no JWT in response').to.be.a('string').and.to.have.length.greaterThan(10);",
                  "});",
                  "if (token) {",
                  "  pm.collectionVariables.set('jwtToken', token);",
                  "  log('JWT saved: ' + token.slice(0, 20) + '...');",
                  "} else {",
                  "  log('No JWT found in login response. Body keys: ' + Object.keys(body).join(', '));",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Chatbot (NestJS)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Folder-level: ensure auth + content-type headers exist on every request.",
              "function ensureHeader(name, value) {",
              "  if (!value) return;",
              "  pm.request.headers.upsert({ key: name, value: value });",
              "}",
              "const jwt = pm.collectionVariables.get('jwtToken') || '';",
              "if (jwt) ensureHeader('Authorization', 'Bearer ' + jwt);",
              "ensureHeader('Content-Type', 'application/json');"
            ]
          }
        }
      ],
      "item": [
        {
          "name": "Init Session",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrlNest}}/chatbot/ping",
              "host": ["{{baseUrlNest}}"],
              "path": ["chatbot", "ping"]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function uuidv4() {",
                  "  return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {",
                  "    const r = (Math.random() * 16) | 0;",
                  "    const v = c === 'x' ? r : (r & 0x3) | 0x8;",
                  "    return v.toString(16);",
                  "  });",
                  "}",
                  "const id = uuidv4();",
                  "pm.collectionVariables.set('sessionId', id);",
                  "console.log('[DIAGNOVA] Session initialized: ' + id);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "console.log('[DIAGNOVA] SessionId is: ' + pm.collectionVariables.get('sessionId'));",
                  "// Route may 404 — that is expected; this request only initialises sessionId."
                ]
              }
            }
          ]
        },
        {
          "name": "Send Message 1 - First Turn",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrlNest}}/chatbot/message",
              "host": ["{{baseUrlNest}}"],
              "path": ["chatbot", "message"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": \"{{sessionId}}\",\n  \"message\": \"What is a pulmonologist and when should I see one?\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const log = (m) => console.log('[DIAGNOVA] ' + m);",
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const ct = pm.response.headers.get('Content-Type') || '';",
                  "pm.test('Content-Type is text/event-stream', function () {",
                  "  pm.expect(ct.toLowerCase()).to.include('text/event-stream');",
                  "});",
                  "const raw = pm.response.text() || '';",
                  "log('Raw SSE response:\\n' + raw);",
                  "function parseSse(text) {",
                  "  const events = [];",
                  "  const lines = text.split('\\n');",
                  "  for (const ln of lines) {",
                  "    if (!ln) continue;",
                  "    if (ln.indexOf('data: ') !== 0) continue;",
                  "    const payload = ln.slice(6);",
                  "    try { events.push(JSON.parse(payload)); } catch (e) { /* skip */ }",
                  "  }",
                  "  return events;",
                  "}",
                  "const events = parseSse(raw);",
                  "const chunks = events.filter(e => e && e.type === 'chunk');",
                  "const done = events.find(e => e && e.type === 'done');",
                  "const assembled = chunks.map(c => c.text || '').join('');",
                  "pm.collectionVariables.set('lastAssembledResponse', assembled);",
                  "pm.test('At least one chunk received', function () {",
                  "  pm.expect(chunks.length, 'no chunks parsed').to.be.greaterThan(0);",
                  "});",
                  "pm.test('Done event present', function () {",
                  "  pm.expect(done, 'no done event').to.not.be.undefined;",
                  "});",
                  "log('Assembled response: ' + assembled);"
                ]
              }
            }
          ]
        },
