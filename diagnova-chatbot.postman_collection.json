                  "  const events = [];",
                  "  const lines = text.split('\\n');",
                  "  for (const ln of lines) {",
                  "    if (!ln) continue;",
                  "    if (ln.indexOf('data: ') !== 0) continue;",
                  "    const payload = ln.slice(6);",
                  "    try { events.push(JSON.parse(payload)); } catch (e) { /* skip */ }",
                  "  }",
                  "  return events;",
                  "}",
                  "const events = parseSse(raw);",
                  "const chunks = events.filter(e => e && e.type === 'chunk');",
                  "const done = events.find(e => e && e.type === 'done');",
                  "const assembled = chunks.map(c => c.text || '').join('');",
                  "pm.test('At least one chunk', function () { pm.expect(chunks.length).to.be.greaterThan(0); });",
                  "pm.test('Done event present', function () { pm.expect(done).to.not.be.undefined; });",
                  "log('Assembled response: ' + assembled);"
                ]
              }
            }
          ]
        },
        {
          "name": "Wrong Internal Key",
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-internal-key", "value": "wrong-key", "type": "text" },
