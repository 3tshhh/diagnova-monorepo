PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/project
REDIS_URL=redis://localhost:6379

JWT_PREFIX=Bearer
JWT_ACCESS_SECRET=replace_access_secret
JWT_REFRESH_SECRET=replace_refresh_secret
JWT_RESET_SECRET=replace_reset_secret

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_RESET_EXPIRES_IN=15m

SALT_ROUNDS=10
ENCRYPTION_SECRET_KEY=12345678901234567890123456789012
IV_LENGTH=12

APP_BASE_URL=http://localhost:3000
BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
FASTAPI_URL=http://localhost:8000
FASTAPI_INTERNAL_URL=http://127.0.0.1:8000
INTERNAL_SECRET=replace_internal_secret

# --- Email (Gmail SMTP) ---
EMAIL_USER=your_gmail_address@gmail.com
GOOGLE_APP_PASSWORD=your_google_app_password

# --- AWS S3 ---
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET=your_s3_bucket_name

# --- AI Service (apps/ai) ---
GEMINI_API_KEY=your_gemini_api_key
HF_TOKEN=your_hf_token_with_read_access
LUNG_SPACE_URL=https://etshh-lung.hf.space
BONE_SPACE_URL=https://etshh-bone.hf.space

